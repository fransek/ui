{
  "name": "@fransek/ui",
  "version": "0.18.0",
  "type": "module",
  "private": false,
  "author": "Frans Ekman <fransedvinekman@gmail.com>",
  "license": "MIT",
  "description": "A design system and component library built on top of Base UI",
  "keywords": [],
  "homepage": "https://github.com/fransek/ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fransek/ui"
  },
  "bugs": {
    "url": "https://github.com/fransek/ui/issues"
  },
  "files": [
    "dist"
  ],
  "main": "dist/cjs/index.js",
  "module": "dist/esm/index.js",
  "style": "dist/esm/theme.css",
  "exports": {
    ".": {
      "style": "./dist/esm/theme.css",
      "import": {
        "types": "./dist/esm/index.d.ts",
        "default": "./dist/esm/index.js"
      },
      "require": {
        "types": "./dist/cjs/index.d.ts",
        "default": "./dist/cjs/index.js"
      }
    },
    "./theme.css": {
      "import": "./dist/esm/theme.css",
      "require": "./dist/cjs/theme.css"
    },
    "./utils": {
      "import": {
        "types": "./dist/esm/lib/utils.d.ts",
        "default": "./dist/esm/lib/utils.js"
      },
      "require": {
        "types": "./dist/cjs/lib/utils.d.ts",
        "default": "./dist/cjs/lib/utils.js"
      }
    },
    "./types": {
      "import": {
        "types": "./dist/esm/lib/types.d.ts",
        "default": "./dist/esm/lib/types.js"
      },
      "require": {
        "types": "./dist/cjs/lib/types.d.ts",
        "default": "./dist/cjs/lib/types.js"
      }
    },
    "./*": {
      "import": {
        "types": "./dist/esm/components/*.d.ts",
        "default": "./dist/esm/components/*.js"
      },
      "require": {
        "types": "./dist/cjs/components/*.d.ts",
        "default": "./dist/cjs/components/*.js"
      }
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "build": "rollup -c",
    "dev": "rollup -c -w",
    "test": "vitest --run --passWithNoTests",
    "test:watch": "vitest",
    "coverage": "vitest --run --coverage --passWithNoTests",
    "lint": "eslint --fix src",
    "format": "prettier --write src",
    "validate": "tsc --noEmit && pnpm lint && pnpm format && pnpm test",
    "prepare": "husky",
    "storybook": "storybook dev -p 6006 --no-open",
    "build-storybook": "storybook build"
  },
  "devDependencies": {
    "@base-ui/react": "^1.8.0",
    "@chromatic-com/storybook": "^5.3.1",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-typescript": "^12.3.0",
    "@storybook/addon-a11y": "^10.6.0",
    "@storybook/addon-docs": "^10.6.0",
    "@storybook/addon-onboarding": "^10.6.0",
    "@storybook/addon-themes": "^10.6.0",
    "@storybook/addon-vitest": "^10.6.0",
    "@storybook/react-vite": "^10.6.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.5.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.70.0",
    "@typescript-eslint/parser": "^8.70.0",
    "@vitest/browser-playwright": "^5.0.0",
    "@vitest/coverage-v8": "^5.0.0",
    "@vitest/ui": "^5.0.0",
    "clsx": "^2.1.1",
    "cssnano": "^9.0.4",
    "cssnano-preset-default": "^9.0.4",
    "date-fns": "^4.4.0",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-storybook": "^10.6.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "lint-staged": "^17.5.1",
    "lucide-react": "^1.46.0",
    "playwright": "^1.63.0",
    "postcss": "^8.5.28",
    "postcss-import": "^17.0.0",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.1",
    "react-dom": "^19.3.0",
    "recharts": "^3.10.1",
    "rollup": "^4.63.3",
    "rollup-plugin-postcss": "^4.0.2",
    "storybook": "^10.6.0",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vitest": "^5.0.0"
  },
  "peerDependencies": {
    "@base-ui/react": "^1.2.0",
    "clsx": "^2.0.0",
    "date-fns": "^4.0.0",
    "lucide-react": ">=0.575.0",
    "react": ">=19.0.0",
    "react-day-picker": "^9.0.0 || ^10.0.0",
    "react-dom": ">=19.0.0",
    "recharts": "^3.0.0",
    "tailwind-merge": "^3.0.0",
    "tailwindcss": "^4.0.0"
  },
  "peerDependenciesMeta": {
    "react-day-picker": {
      "optional": true
    },
    "date-fns": {
      "optional": true
    },
    "recharts": {
      "optional": true
    }
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "prettier --write",
      "eslint --fix",
      "bash -c tsc --noEmit"
    ]
  },
  "publishConfig": {
    "access": "public"
  }
}
